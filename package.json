{
  "name": "nail-boss",
  "version": "1.0.0",
  "description": "AnitaSet — design-first operating system for independent nail businesses",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm install --prefix client && npm run build --prefix client",
    "test": "ANITASET_TEST_DB_FILE=.tmp/smoke-test-db.json node scripts/smoke-test.js",
    "test:geometry": "node scripts/geometry-helper-test.mjs",
    "dev:server": "nodemon server.js",
    "dev:client": "cd client && npm start",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "install:all": "npm install && cd client && npm install",
    "db:migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "uuid": "^9.0.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
